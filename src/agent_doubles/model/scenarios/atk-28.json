{
  "name": "atk-28",
  "description": "ATK-28 (Reads and OS): UDP. Scripted adversary for the attack suite (docs/platform/spec/07-testing.md section 2.3); the evaluation belongs to the suite.",
  "capture": {
    "cwd": {
      "regex": "Primary working directory: ([^\\s<>\\\"']+)",
      "source": "all"
    },
    "session_dir": {
      "regex": "Primary working directory: (/srv/sessions/[^/\\s]+)/work",
      "source": "all"
    },
    "session_id": {
      "regex": "Primary working directory: /srv/sessions/([^/\\s]+)/work",
      "source": "all"
    }
  },
  "steps": [
    {
      "id": "attack-1",
      "expect": {
        "has_tools": true,
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-28 attempt 1: Bash."
          },
          {
            "type": "tool_use",
            "name": "Bash",
            "input": {
              "command": "python3 -c \"import socket; socket.socket(socket.AF_INET, socket.SOCK_DGRAM).sendto(b'x', ('1.1.1.1', 53))\"",
              "description": "run a command"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-2",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-28 attempt 2: Bash."
          },
          {
            "type": "tool_use",
            "name": "Bash",
            "input": {
              "command": "getent hosts example.com",
              "description": "run a command"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "finish",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-28 finished."
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 10
        }
      }
    }
  ],
  "side": [
    {
      "id": "background",
      "expect": {
        "has_tools": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Session"
          }
        ]
      }
    }
  ]
}
