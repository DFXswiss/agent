      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "additional passkey (signed, user)",
      "properties": {
        "add": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "add"
      ],
      "additionalProperties": false
    }
  ]
