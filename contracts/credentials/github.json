{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/credentials/github.json",
  "title": "credential body github",
  "description": "Plaintext body of the credential kind github inside the record ciphertext (04-crypto.md section 4.4).",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "printable ASCII without spaces",
      "pattern": "^[!-~]+$",
      "minLength": 1,
      "maxLength": 4096
    },
    "login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,39}$"
    },
    "user_id": {
      "$ref": "../common.json#/$defs/positive"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9:_-]{1,64}$"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "created_at": {
      "$ref": "../common.json#/$defs/time"
    }
  },
  "required": [
    "token",
    "login",
    "user_id",
    "scopes",
    "created_at"
  ],
  "additionalProperties": false
}
