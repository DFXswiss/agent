{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/tasks-create.request.json",
  "title": "POST /v1/tasks request",
  "description": "events = [task.meta, prompt] (03-api.md section 4.6); placement: the chosen device and VM (ADR-075 section 6)",
  "type": "object",
  "properties": {
    "task_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "wg_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/event"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "placement": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "vm_id": {
          "$ref": "../common.json#/$defs/vm_id"
        }
      },
      "required": [
        "device_id"
      ],
      "additionalProperties": false
    },
    "github_identity": {
      "$ref": "../common.json#/$defs/uuid",
      "description": "the GitHub identity of the task (ADR-078 section 3); optional"
    },
    "modes": {
      "type": "array",
      "description": "working modes the creating person chooses for the new task (ADR-098 section 3, way web or tool; an agent of a session passes on modes of its own task, way inherited); optional, nothing is chosen without it",
      "items": {
        "$ref": "../common.json#/$defs/mode_name"
      },
      "maxItems": 16
    },
    "analysis": {
      "type": "object",
      "description": "a task of the kind analysis (ADR-097 section 1): its scope and period (default the last 7 days)",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "org",
            "wg"
          ]
        },
        "since": {
          "$ref": "../common.json#/$defs/time"
        },
        "until": {
          "$ref": "../common.json#/$defs/time"
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "task_id",
    "wg_id",
    "events"
  ],
  "additionalProperties": false
}
