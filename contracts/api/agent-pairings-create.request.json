{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/agent-pairings-create.request.json",
  "title": "POST /v1/agent-pairings request",
  "description": "Body of POST /v1/agent-pairings (11-agent-access.md section 4); `remote: true` creates a pairing from another computer (ADR-062, section 5.4).",
  "type": "object",
  "properties": {
    "pairing_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "pub": {
      "type": "object",
      "properties": {
        "kem": {
          "$ref": "../common.json#/$defs/b64u_32"
        },
        "sig": {
          "$ref": "../common.json#/$defs/b64u_32"
        }
      },
      "required": [
        "kem",
        "sig"
      ],
      "additionalProperties": false
    },
    "pop": {
      "$ref": "../common.json#/$defs/b64u_64"
    },
    "remote": {
      "type": "boolean",
      "description": "true: a pairing from another computer (ADR-062); absent or false: the loopback pairing"
    }
  },
  "required": [
    "pairing_id",
    "pub",
    "pop"
  ],
  "additionalProperties": false
}
