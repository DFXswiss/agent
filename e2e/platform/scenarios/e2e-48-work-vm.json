{
  "name": "e2e-48-work-vm",
  "description": "E2E-48 (KOR-29): the session checks out a repository, gets a work VM, runs the failing tests, fixes the code, runs them green and opens a draft pull request through the platform; a follow-up starts a service in the same VM, reads its page with the browser, shows the VM's status and asks for a VM above the device's size limit and gets a clear refusal (no fixed number of VMs per task, ADR-075 addendum 2). Every result is checked by the next step's expectation.",
  "steps": [
    {
      "id": "checkout",
      "expect": {
        "user_text_contains": "E2E48-FIX",
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Checking out the repository first."
          },
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "github.checkout",
              "params": {
                "repo": "octo-org/calc"
              }
            }
          }
        ]
      }
    },
    {
      "id": "request-vm",
      "expect": {
        "tool_result_contains": "\"dir\":\"repos/octo-org/calc\""
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "workvm.request",
              "params": {}
            }
          }
        ]
      }
    },
    {
      "id": "tests-red",
      "expect": {
        "tool_result_contains": "\"created\":true"
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__workvm_exec",
            "input": {
              "command": "cd repos/octo-org/calc && python3 test_calc.py",
              "wait_seconds": 30
            }
          }
        ]
      }
    },
    {
      "id": "fix",
      "expect": {
        "tool_result_contains": "\"exit_code\":1"
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "Write",
            "input": {
              "file_path": "${cwd}/repos/octo-org/calc/calc.py",
              "content": "def add(a, b):\n    return a + b  # kz48-file-m2n6b8v4\n"
            }
          }
        ]
      }
    },
    {
      "id": "tests-green",
      "expect": {
        "tool_result_is_error": false
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__workvm_exec",
            "input": {
              "command": "cd repos/octo-org/calc && python3 test_calc.py",
              "wait_seconds": 30
            }
          }
        ]
      }
    },
    {
      "id": "branch",
      "expect": {
        "tool_result_contains": "\"exit_code\":0"
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "github.create_branch",
              "params": {
                "repo": "octo-org/calc",
                "branch": "e2e48/fix",
                "from": "main"
              }
            }
          }
        ]
      }
    },
    {
      "id": "commit",
      "expect": {
        "tool_result_contains": "\"branch\":\"e2e48/fix\""
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "github.commit",
              "params": {
                "repo": "octo-org/calc",
                "branch": "e2e48/fix",
                "message": "Fix the addition."
              }
            }
          }
        ]
      }
    },
    {
      "id": "push",
      "expect": {
        "tool_result_contains": "\"files_changed\":1"
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "github.push",
              "params": {
                "repo": "octo-org/calc",
                "branch": "e2e48/fix",
                "commit_sha": "${commit}"
              }
            }
          }
        ]
      },
      "capture": {
        "commit": {
          "regex": "\"commit_sha\":\"([0-9a-f]{40})\",\"files_changed\"",
          "source": "messages"
        }
      }
    },
    {
      "id": "pull-request",
      "expect": {
        "tool_result_contains": "\"url\":\"https://github.example/octo-org/calc/tree/e2e48/fix\""
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "github.create_pull_request",
              "params": {
                "repo": "octo-org/calc",
                "head": "e2e48/fix",
                "base": "main",
                "title": "Fix the addition kz48-title-c4x9z1q7",
                "body": "Tests pass in the work VM.",
                "draft": true
              }
            }
          }
        ]
      }
    },
    {
      "id": "fixed",
      "expect": {
        "tool_result_contains": "\"url\":\"https://github.example/octo-org/calc/pull/1\""
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "The tests failed, I fixed add() and they pass now; draft pull request #1 is open kz48-answer-h3j7k1l5."
          }
        ]
      }
    },
    {
      "id": "service",
      "expect": {
        "user_text_contains": "E2E48-SERVICE"
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__workvm_exec",
            "input": {
              "command": "mkdir -p /srv/kz48 && printf '<title>KZ48 page</title><h1>Hello kz48-page-r5t8y2u4</h1>' > /srv/kz48/index.html && systemd-run --unit=kz48-site python3 -m http.server 8048 --directory /srv/kz48 && sleep 2 && systemctl is-active kz48-site && curl -s http://127.0.0.1:8048/",
              "sync": "none",
              "wait_seconds": 30
            }
          }
        ]
      }
    },
    {
      "id": "browse",
      "expect": {
        "tool_result_contains": "Hello kz48-page-r5t8y2u4"
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__workvm_browse",
            "input": {
              "url": "http://127.0.0.1:8048/"
            }
          }
        ]
      }
    },
    {
      "id": "status",
      "expect": {
        "tool_result_contains": "\"title\":\"KZ48 page\""
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__workvm_status",
            "input": {}
          }
        ]
      }
    },
    {
      "id": "second-vm",
      "expect": {
        "tool_result_contains": "\"workvm_id\":\"wvm-"
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "workvm.request",
              "params": {
                "scope": "session",
                "size": "xlarge"
              }
            }
          }
        ]
      }
    },
    {
      "id": "served",
      "expect": {
        "tool_result_contains": "limit_exceeded"
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "The page says: Hello kz48-page-r5t8y2u4. A work VM of size xlarge is above the limit of this device kz48-answer-p8o2i6u3."
          }
        ]
      }
    }
  ],
  "side": [
    {
      "id": "title",
      "expect": {
        "has_tools": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Work VM"
          }
        ]
      }
    }
  ]
}
