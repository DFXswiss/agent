{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/ws/sse/query.json",
  "title": "GET /v1/stream query",
  "description": "Query parameters of GET /v1/stream (03-api.md section 5): one org, up to three watched terminals, cursors scope_id:seq separated by commas, monitoring=1, account=1 (the user's account notifications, 11-agent-access.md section 8).",
  "type": "object",
  "properties": {
    "org": {
      "$ref": "../../common.json#/$defs/uuid"
    },
    "terminal": {
      "type": "array",
      "items": {
        "$ref": "../../common.json#/$defs/uuid"
      },
      "minItems": 1,
      "maxItems": 3
    },
    "cursors": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:(0|[1-9][0-9]{0,15})(,[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:(0|[1-9][0-9]{0,15})){0,255}$",
      "maxLength": 16384
    },
    "monitoring": {
      "type": "string",
      "const": "1"
    },
    "account": {
      "type": "string",
      "const": "1"
    }
  },
  "required": [
    "org"
  ],
  "additionalProperties": false
}
