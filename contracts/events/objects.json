            "params"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation_id": {
              "$ref": "../common.json#/$defs/uuid"
            },
            "type": {
              "type": "string",
              "const": "github.create_pull_request"
            },
            "params": {
