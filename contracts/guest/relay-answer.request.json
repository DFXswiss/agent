{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/guest/relay-answer.request.json",
  "title": "guest POST /v1/relay/{id}/answer request",
  "description": "Answer of a relay pending call: the hub's answer as the hub sent it, or the runner's refusal (05-runner.md section 17.2).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "$ref": "objects.json#/$defs/relay_response_headers"
        },
        "body": {
          "$ref": "../common.json#/$defs/b64u"
        }
      },
      "required": [
        "status",
        "headers",
        "body"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "enum": [
            "refused",
            "hub_unreachable",
            "too_large"
          ]
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
