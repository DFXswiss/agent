{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/mcp/initialize.params.json",
  "title": "initialize params",
  "description": "Params of initialize (03-api.md section 8).",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "minLength": 1,
      "maxLength": 32
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {}
    },
    "clientInfo": {
      "type": "object",
      "$comment": "open: MCP client information (third-party)",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": {}
    },
    "_meta": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "protocolVersion",
    "capabilities",
    "clientInfo"
  ],
  "additionalProperties": false
}
