{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/github-identity-get.response.json",
  "title": "GET /v1/github-identities/{id} response",
  "description": "An identity record the caller may open: an own record, or a company record of an organization the caller is an active member of (03-api.md section 4.8).",
  "type": "object",
  "properties": {
    "owner_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "owner_kind": {
      "type": "string",
      "enum": [
        "user",
        "org"
      ]
    },
    "primary": {
      "type": "boolean"
    },
    "record": {
      "$ref": "../common.json#/$defs/credential_record"
    }
  },
  "required": [
    "owner_id",
    "owner_kind",
    "primary",
    "record"
  ],
  "additionalProperties": false
}
