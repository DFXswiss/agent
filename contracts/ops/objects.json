    "result_github_list_issues": {
      "type": "object",
      "description": "one page of the repository's issues; per_page and page count issues (pull requests, which GitHub lists among the issues, are left out and do not count), so a page is empty only when there are no further issues; truncated: entries that did not fit the contract were left out or titles were cut, or the flood limit ended the reading (then note says how to go on)",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "$ref": "#/$defs/number"
              },
              "title": {
                "type": "string",
                "maxLength": 1024
              },
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "state_reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "completed",
                      "not_planned",
                      "reopened",
                      "duplicate"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "author": {
                "$ref": "#/$defs/github_login"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "label name (GitHub allows at most 50 characters)",
                  "minLength": 1,
                  "maxLength": 100
                },
                "minItems": 0,
                "maxItems": 100
              },
              "assignees": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/github_login"
                },
                "minItems": 0,
                "maxItems": 100
              },
              "comments": {
                "$ref": "../common.json#/$defs/count"
              },
              "created_at": {
                "$ref": "#/$defs/github_time"
              },
              "updated_at": {
                "$ref": "#/$defs/github_time"
              },
              "closed_at": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/github_time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "url": {
                "$ref": "#/$defs/url"
              }
            },
            "required": [
              "number",
              "title",
              "state",
              "state_reason",
              "author",
              "labels",
              "assignees",
              "comments",
              "created_at",
              "updated_at",
              "closed_at",
              "url"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "next_page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 2,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ],
          "description": "the page to ask for next, null on the last page"
        },
        "truncated": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 500,
          "description": "present when the flood limit ended the reading before the page was complete: how to reach the issues beyond it"
        }
      },
      "required": [
        "issues",
        "next_page",
        "truncated"
      ],
      "additionalProperties": false
    },
