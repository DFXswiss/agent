{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/mcp/tools-list.result.json",
  "title": "tools/list result",
  "description": "Result of tools/list: exactly the tools of 03-api.md section 8.1 and 13-work-vm.md sections 3 and 13.4; inputSchema is the dereferenced mcp/tools/<tool>.input.json.",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "get_context",
              "list_workgroups",
              "list_members",
              "list_tasks",
              "get_task",
              "get_task_messages",
              "get_whiteboard",
              "get_notifications",
              "request_operation",
              "get_operation",
              "list_operations",
              "get_usage",
              "list_audit",
              "list_workgroup_operations",
              "get_metrics",
              "get_subagent_result",
              "workvm_exec",
              "workvm_output",
              "workvm_kill",
              "workvm_status",
              "workvm_sync",
              "workvm_browse",
              "browser_navigate",
              "browser_snapshot",
              "browser_click",
              "browser_hover",
              "browser_type",
              "browser_select",
              "browser_press",
              "browser_scroll",
              "browser_wait",
              "browser_evaluate",
              "browser_upload",
              "browser_dialog",
              "browser_tabs",
              "browser_download",
              "browser_screenshot"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "inputSchema": {
            "type": "object",
            "description": "JSON Schema (type object, additionalProperties false)",
            "additionalProperties": {}
          }
        },
        "required": [
          "name",
          "description",
          "inputSchema"
        ],
        "additionalProperties": false
      },
      "minItems": 16,
      "maxItems": 16
    }
  },
  "required": [
    "tools"
  ],
  "additionalProperties": false
}
