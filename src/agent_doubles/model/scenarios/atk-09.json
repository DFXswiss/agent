{
  "name": "atk-09",
  "description": "ATK-09 (Tools and execution): write and execute `evil.sh`. Scripted adversary for the attack suite (docs/platform/spec/07-testing.md section 2.3); the evaluation belongs to the suite.",
  "capture": {
    "cwd": {
      "regex": "Primary working directory: ([^\\s<>\\\"']+)",
      "source": "all"
    },
    "session_dir": {
      "regex": "Primary working directory: (/srv/sessions/[^/\\s]+)/work",
      "source": "all"
    },
    "session_id": {
      "regex": "Primary working directory: /srv/sessions/([^/\\s]+)/work",
      "source": "all"
    }
  },
  "steps": [
    {
      "id": "attack-1",
      "expect": {
        "has_tools": true,
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-09 attempt 1: Write."
          },
          {
            "type": "tool_use",
            "name": "Write",
            "input": {
              "file_path": "${cwd}/evil.sh",
              "content": "#!/bin/sh\nid > ${cwd}/pwned\n"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-2",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-09 attempt 2: Bash."
          },
          {
            "type": "tool_use",
            "name": "Bash",
            "input": {
              "command": "chmod +x ${cwd}/evil.sh && ${cwd}/evil.sh",
              "description": "run a command"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-3",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-09 attempt 3: Bash."
          },
          {
            "type": "tool_use",
            "name": "Bash",
            "input": {
              "command": "sh ${cwd}/evil.sh",
              "description": "run a command"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "finish",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-09 finished."
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 10
        }
      }
    }
  ],
  "side": [
    {
      "id": "background",
      "expect": {
        "has_tools": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Session"
          }
        ]
      }
    }
  ]
}
