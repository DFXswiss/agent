{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/requests/github.connect.response.json",
  "title": "device response body github.connect",
  "description": "Plaintext body of a device response to github.connect (seq 1..n, final on the last; 05-runner.md section 11). Never contains a secret, except the body of a company account for the requesting admin (KOR-47).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "device_code"
        },
        "user_code": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{4,16}$"
        },
        "verification_uri": {
          "type": "string",
          "description": "https URL, or http on the loopback host (hermetic doubles)",
          "pattern": "^(https://[!-~]{1,2040}|http://(127\\.0\\.0\\.1|localhost)(:[0-9]{1,5})?(/[!-~]{0,2000})?)$",
          "maxLength": 2048
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "step",
        "user_code",
        "verification_uri",
        "expires_in"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "done"
        },
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9:_-]{1,64}$"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "source": {
          "type": "string",
          "enum": [
            "device_flow",
            "token",
            "operator"
          ]
        },
        "identity_id": {
          "$ref": "../common.json#/$defs/uuid",
          "description": "the record ID of the identity (KOR-47)"
        },
        "signing": {
          "type": "string",
          "enum": [
            "registered",
            "scope_missing",
            "refused"
          ],
          "description": "outcome of signing_key (KOR-47)"
        },
        "body": {
          "$ref": "objects.json#/$defs/github_body",
          "description": "company accounts only (org_id): the credential body for the requesting admin's client, which seals it under the org key, signs and stores it; the response is end-to-end encrypted to that admin, who can open the stored record anyway (KOR-47)"
        }
      },
      "required": [
        "step",
        "login"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "failed"
        },
        "code": {
          "$ref": "objects.json#/$defs/failure_code"
        }
      },
      "required": [
        "step",
        "code"
      ],
      "additionalProperties": false
    }
  ]
}
