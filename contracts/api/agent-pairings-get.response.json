{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/agent-pairings-get.response.json",
  "title": "GET /v1/agent-pairings/{pairing_id} response",
  "description": "Body of a successful response to GET /v1/agent-pairings/{pairing_id} (11-agent-access.md section 4).",
  "type": "object",
  "properties": {
    "pairing_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "pub": {
      "type": "object",
      "properties": {
        "kem": {
          "$ref": "../common.json#/$defs/b64u_32"
        },
        "sig": {
          "$ref": "../common.json#/$defs/b64u_32"
        }
      },
      "required": [
        "kem",
        "sig"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "confirmed",
        "active",
        "closed"
      ]
    },
    "expires_at": {
      "$ref": "../common.json#/$defs/time"
    },
    "remote": {
      "const": true,
      "description": "present (true) only for a pairing from another computer (ADR-062)"
    },
    "nonce": {
      "$ref": "../common.json#/$defs/b64u_16",
      "description": "the hub's nonce of a remote pairing, input of the agent code (11-agent-access.md section 3); present exactly with remote"
    }
  },
  "required": [
    "pairing_id",
    "pub",
    "state",
    "expires_at"
  ],
  "additionalProperties": false
}
