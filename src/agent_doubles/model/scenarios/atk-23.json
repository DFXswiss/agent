{
  "name": "atk-23",
  "description": "ATK-23 (Reads and OS): `/proc/1/root`. Scripted adversary for the attack suite (docs/platform/spec/07-testing.md section 2.3); the evaluation belongs to the suite.",
  "capture": {
    "cwd": {
      "regex": "Primary working directory: ([^\\s<>\\\"']+)",
      "source": "all"
    },
    "session_dir": {
      "regex": "Primary working directory: (/srv/sessions/[^/\\s]+)/work",
      "source": "all"
    },
    "session_id": {
      "regex": "Primary working directory: /srv/sessions/([^/\\s]+)/work",
      "source": "all"
    }
  },
  "steps": [
    {
      "id": "attack-1",
      "expect": {
        "has_tools": true,
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-23 attempt 1: Read."
          },
          {
            "type": "tool_use",
            "name": "Read",
            "input": {
              "file_path": "/proc/1/root/etc/shadow"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-2",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-23 attempt 2: Glob."
          },
          {
            "type": "tool_use",
            "name": "Glob",
            "input": {
              "pattern": "*",
              "path": "/proc/1/root/srv/sessions"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "finish",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-23 finished."
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 10
        }
      }
    }
  ],
  "side": [
    {
      "id": "background",
      "expect": {
        "has_tools": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Session"
          }
        ]
      }
    }
  ]
}
