{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/requests/claude.login.response.json",
  "title": "device response body claude.login",
  "description": "Plaintext body of a device response to claude.login (seq 1..n, final on the last; 05-runner.md section 11). Never contains a secret. verify (KOR-73): the automation met a check for humans; image is the sandbox's viewport (JPEG, base64) sealed to the requester like every response, frame counts the pictures of the login. needs_human (ADR-103, only to a root with vnc): a check for humans waits for the owner; vnc_available says whether its sandbox has a screen the owner can take over with vnc.open {kind: login, id: this request}.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "authorize"
        },
        "url": {
          "type": "string",
          "description": "https URL, or http on the loopback host (hermetic doubles)",
          "pattern": "^(https://[!-~]{1,2040}|http://(127\\.0\\.0\\.1|localhost)(:[0-9]{1,5})?(/[!-~]{0,2000})?)$",
          "maxLength": 2048
        },
        "automation": {
          "type": "string",
          "const": "failed"
        },
        "reason": {
          "type": "string",
          "description": "why the automation gave up (KOR-73): disabled (switched off), no_sandbox (no browser sandbox on the device), human_check (no click passed the check for humans in time, or the owner chose relay), consent_missing (the registration asks for a consent the owner did not give), account_missing (the address has no account and the request carries no account data), unknown_page (a page the automation does not know), mail_timeout (no mail in time), browser_failed (the sandbox browser failed)",
          "enum": [
            "disabled",
            "no_sandbox",
            "human_check",
            "consent_missing",
            "account_missing",
            "unknown_page",
            "mail_timeout",
            "browser_failed"
          ]
        }
      },
      "required": [
        "step",
        "url"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "progress"
        },
        "stage": {
          "type": "string",
          "enum": [
            "browser_started",
            "email_entered",
            "magic_link_received",
            "authorized",
            "mail_code_received",
            "registered",
            "verified"
          ]
        }
      },
      "required": [
        "step",
        "stage"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "verify"
        },
        "frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "number of the picture within the login"
        },
        "image": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "data": {
              "type": "string",
              "description": "JPEG, base64 (standard alphabet, padded), at most 100 KiB",
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "minLength": 4,
              "maxLength": 136536
            }
          },
          "required": [
            "width",
            "height",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "step",
        "frame",
        "image"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "needs_human"
        },
        "vnc_available": {
          "type": "boolean"
        }
      },
      "required": [
        "step",
        "vnc_available"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "done"
        },
        "email": {
          "type": "string",
          "pattern": "^[!-?A-~]{1,64}@[A-Za-z0-9-]{1,63}(\\.[A-Za-z0-9-]{1,63}){0,8}$",
          "maxLength": 254
        }
      },
      "required": [
        "step"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "failed"
        },
        "code": {
          "$ref": "objects.json#/$defs/failure_code"
        }
      },
      "required": [
        "step",
        "code"
      ],
      "additionalProperties": false
    }
  ]
}
