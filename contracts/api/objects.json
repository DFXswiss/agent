{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/objects.json",
  "title": "Shared API objects",
  "description": "Rows and nested objects shared by several browser endpoints and the live channels.",
  "$defs": {
    "settings": {
      "type": "object",
      "description": "plaintext user preferences (02-data-model.md section 2.1)",
      "properties": {
        "model_access": {
          "$ref": "../common.json#/$defs/model_access_pref"
        },
        "model_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/model_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "locale": {
          "$ref": "../common.json#/$defs/locale"
        },
        "fallback": {
          "$ref": "#/$defs/fallback_settings",
          "description": "always sent by a hub of KOR-50 or later; absent from an older hub (the defaults apply)"
        }
      },
      "required": [
        "model_access",
        "model_id",
        "locale"
      ],
      "additionalProperties": false
    },
    "task_row": {
      "type": "object",
      "description": "task metadata (02-data-model.md section 2.4); the title lives only in task.meta events",
      "properties": {
        "task_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "org_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "wg_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "owner_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "state": {
          "$ref": "../common.json#/$defs/task_state"
        },
        "state_reason": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/session_failure_reason"
            },
            {
              "type": "null"
            },
            {
              "$ref": "../common.json#/$defs/task_waiting_reason"
            }
          ]
        },
        "created_at": {
          "$ref": "../common.json#/$defs/time"
        },
        "state_at": {
          "$ref": "../common.json#/$defs/time"
        },
        "last_activity_at": {
          "$ref": "../common.json#/$defs/time"
        },
        "closed_at": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "main_session_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "title_event_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/placement"
            },
            {
              "type": "null"
            }
          ]
        },
        "github_identity": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "the GitHub identity chosen for the task (ADR-078 section 3)"
        }
      },
      "required": [
        "task_id",
        "org_id",
        "wg_id",
        "owner_id",
        "state",
        "state_reason",
        "created_at",
        "state_at",
        "last_activity_at",
        "closed_at",
        "main_session_id",
        "title_event_id"
      ],
      "additionalProperties": false
    },
    "task_transition": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "../common.json#/$defs/positive"
        },
        "state": {
          "$ref": "../common.json#/$defs/task_state"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/error_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "$ref": "../common.json#/$defs/time"
        }
      },
      "required": [
        "seq",
        "state",
        "reason",
        "at"
      ],
      "additionalProperties": false
    },
    "attention_row": {
      "type": "object",
      "description": "attention record of a task (03-api.md section 4.6.0, ADR-076; KOR-39): category and reason code, the operation or session it refers to, when it entered its category, a counter that grows with every change, the subagent counters",
      "properties": {
        "task_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "category": {
          "$ref": "../common.json#/$defs/attention_category"
        },
        "reason": {
          "$ref": "../common.json#/$defs/attention_reason"
        },
        "ref_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "operation",
                "session"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ref_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "since": {
          "$ref": "../common.json#/$defs/time"
        },
        "seq": {
          "$ref": "../common.json#/$defs/positive"
        },
        "subagents_total": {
          "$ref": "../common.json#/$defs/count"
        },
        "subagents_active": {
          "$ref": "../common.json#/$defs/count"
        },
        "updated_at": {
          "$ref": "../common.json#/$defs/time"
        },
        "wait_until": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ],
          "description": "KOR-50, ADR-081 section 5: the time a quota_wait or quota_choice record continues by itself (null: unknown); absent for every other reason and from an older hub"
        }
      },
      "required": [
        "task_id",
        "category",
        "reason",
        "ref_kind",
        "ref_id",
        "since",
        "seq",
        "subagents_total",
        "subagents_active",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "attention_item": {
      "type": "object",
      "description": "one entry of the situation view: the task and its attention record (KOR-39)",
      "properties": {
        "task": {
          "$ref": "#/$defs/task_row"
        },
        "attention": {
          "$ref": "#/$defs/attention_row"
        }
      },
      "required": [
        "task",
        "attention"
      ],
      "additionalProperties": false
    },
    "session_row": {
      "type": "object",
      "description": "session metadata (02-data-model.md section 2.4)",
      "properties": {
        "session_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "task_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "org_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "wg_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "owner_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "device_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "vm_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/vm_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_session_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin_operation_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "state": {
          "$ref": "../common.json#/$defs/session_state"
        },
        "state_reason": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/session_failure_reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_access": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/model_access"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/model_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_kind": {
          "type": "string",
          "enum": [
            "claude-code"
          ]
        },
        "agent_version": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/version_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimate_ms": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/count"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "../common.json#/$defs/time"
        },
        "ready_at": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_working_at": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_restore": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "restored",
                "fallback"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "context_reason": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/context_reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "github_identity": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "the GitHub identity of the session (subagents, ADR-078 section 3)"
        },
        "triggered_by": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "the person whose instruction created the session (ADR-083 section 2): the author of the prompt a main session was created for, the triggering person of the subagent.request of a child session; null when unknown"
        }
      },
      "required": [
        "session_id",
        "task_id",
        "org_id",
        "wg_id",
        "owner_id",
        "device_id",
        "vm_id",
        "parent_session_id",
        "origin_operation_id",
        "depth",
        "state",
        "state_reason",
        "model_access",
        "model_id",
        "agent_kind",
        "agent_version",
        "estimate_ms",
        "created_at",
        "ready_at",
        "first_working_at",
        "ended_at"
      ],
      "additionalProperties": false
    },
    "session_transition": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "../common.json#/$defs/positive"
        },
        "state": {
          "$ref": "../common.json#/$defs/session_state"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/error_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "$ref": "../common.json#/$defs/time"
        },
        "received_at": {
          "$ref": "../common.json#/$defs/time"
        }
      },
      "required": [
        "seq",
        "state",
        "reason",
        "at",
        "received_at"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "description": "usage counter of one session (02-data-model.md section 2.8)",
      "properties": {
        "requests": {
          "$ref": "../common.json#/$defs/count"
        },
        "input_tokens": {
          "$ref": "../common.json#/$defs/count"
        },
        "output_tokens": {
          "$ref": "../common.json#/$defs/count"
        },
        "cache_read_tokens": {
          "$ref": "../common.json#/$defs/count"
        },
        "cache_write_tokens": {
          "$ref": "../common.json#/$defs/count"
        },
        "thinking_tokens": {
          "$ref": "../common.json#/$defs/count"
        },
        "cost_micro_usd": {
          "$ref": "../common.json#/$defs/count"
        },
        "cost_basis": {
          "type": "string",
          "enum": [
            "provider",
            "list_price",
            "subscription_equivalent"
          ]
        },
        "context_used_tokens": {
          "$ref": "../common.json#/$defs/count"
        },
        "context_window_tokens": {
          "$ref": "../common.json#/$defs/count"
        },
        "last_provider": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[ -~]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "$ref": "../common.json#/$defs/time"
        }
      },
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "thinking_tokens",
        "cost_micro_usd",
        "cost_basis",
        "context_used_tokens",
        "context_window_tokens",
        "last_provider",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "vm_row": {
      "type": "object",
      "description": "VM as reported by the runner (02-data-model.md section 2.4)",
      "properties": {
        "vm_id": {
          "$ref": "../common.json#/$defs/vm_id"
        },
        "device_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "wg_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "pool",
            "assigning",
            "running",
            "stopping",
            "stopped",
            "deleted"
          ]
        },
        "golden_version": {
          "$ref": "../common.json#/$defs/version_text"
        },
        "cpus": {
          "$ref": "../common.json#/$defs/positive"
        },
        "memory_mib": {
          "$ref": "../common.json#/$defs/positive"
        },
        "disk_gib": {
          "$ref": "../common.json#/$defs/positive"
        },
        "created_at": {
          "$ref": "../common.json#/$defs/time"
        },
        "state_at": {
          "$ref": "../common.json#/$defs/time"
        }
      },
      "required": [
        "vm_id",
        "device_id",
        "wg_id",
        "state",
        "golden_version",
        "cpus",
        "memory_mib",
        "disk_gib",
        "created_at",
        "state_at"
      ],
      "additionalProperties": false
    },
    "operation_row": {
      "type": "object",
      "description": "operation metadata (02-data-model.md section 2.5); parameters and results only in events",
      "properties": {
        "operation_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "org_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "wg_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "task_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "session_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "device_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "actor_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "type": {
          "$ref": "../common.json#/$defs/operation_type"
        },
        "state": {
          "$ref": "../common.json#/$defs/operation_state"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/operation_error_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "$ref": "../common.json#/$defs/count"
        },
        "params_event_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_event_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "../common.json#/$defs/time"
        },
        "decided_at": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "github_identity": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "the GitHub identity the operation acted with (ADR-078 section 6); null for other types and for operations registered by older runners"
        },
        "triggered_by": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "the human whose instruction the operation followed (ADR-078 section 2); null for operations registered by older runners"
        }
      },
      "required": [
        "operation_id",
        "org_id",
        "wg_id",
        "task_id",
        "session_id",
        "device_id",
        "actor_id",
        "type",
        "state",
        "error_code",
        "retryable",
        "duplicate_of",
        "attempt",
        "params_event_id",
        "result_event_id",
        "created_at",
        "decided_at",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "operation_transition": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "../common.json#/$defs/positive"
        },
        "state": {
          "$ref": "../common.json#/$defs/operation_state"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/operation_error_code"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "$ref": "../common.json#/$defs/time"
        },
        "by_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "seq",
        "state",
        "error_code",
        "at",
        "by_id"
      ],
      "additionalProperties": false
    },
    "notification_row": {
      "type": "object",
      "description": "content-free notification (02-data-model.md section 2.6)",
      "properties": {
        "notification_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "whiteboard.entry",
            "task.idle",
            "task.failed",
            "task.attention",
            "invite.accepted",
            "rotation.required",
            "agent.account_change",
            "org.admitted",
            "operator.request",
            "device.needed",
            "model.switched",
            "prompt.waiting_for_device"
          ]
        },
        "org_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "null only for agent.account_change (an account-level notification, 11-agent-access.md section 8) and operator.request (a request to the operator, ADR-079)"
        },
        "wg_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "task_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/uuid"
            },
            {
              "type": "string",
              "pattern": "^[a-z_]{1,32}:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?:[A-Za-z0-9_:-]{0,128}$",
              "maxLength": 200,
              "description": "agent.account_change: <action>:<acting agent ID or empty>:<target> (11-agent-access.md section 8)"
            },
            {
              "type": "string",
              "pattern": "^(needs_decision|blocked):[a-z][a-z0-9_]{0,63}:([1-9][0-9]{0,15}|wg)$",
              "description": "task.attention (KOR-39): <category>:<reason>:<seq of the attention record>, or <category>:<reason>:wg for a workgroup-wide cause (03-api.md section 4.9)"
            },
            {
              "type": "string",
              "pattern": "^(subscription|api_key|platform|operator):(subscription|api_key|platform|operator):([0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z)?$",
              "description": "model.switched (KOR-50, ADR-081 section 5): <from access>:<to access>:<until or empty>, the session's model access changed because its access was used up, unusable or released (task_id: the session's task)"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "../common.json#/$defs/time"
        },
