{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/guest/sessions-create.request.json",
  "title": "guest POST /v1/sessions request",
  "description": "Request of POST /v1/sessions (03-api.md section 7.1).",
  "type": "object",
  "properties": {
    "session_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "task_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "parent_session_id": {
      "anyOf": [
        {
          "$ref": "../common.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "harness": {
      "type": "object",
      "properties": {
        "context_markdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "context_markdown"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "../common.json#/$defs/model_access"
        },
        "model_id": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/model_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "env": {
          "type": "object",
          "description": "model environment of 05-runner.md section 10.3 (only for the platform access); every other variable is fixed by the guest",
          "properties": {
            "ANTHROPIC_MODEL": {
              "type": "string",
              "pattern": "^[ -~]+$",
              "minLength": 1,
              "maxLength": 256
            },
            "ANTHROPIC_DEFAULT_OPUS_MODEL": {
              "type": "string",
              "pattern": "^[ -~]+$",
              "minLength": 1,
              "maxLength": 256
            },
            "ANTHROPIC_DEFAULT_SONNET_MODEL": {
              "type": "string",
              "pattern": "^[ -~]+$",
              "minLength": 1,
              "maxLength": 256
            },
            "ANTHROPIC_DEFAULT_HAIKU_MODEL": {
              "type": "string",
              "pattern": "^[ -~]+$",
              "minLength": 1,
              "maxLength": 256
            },
            "CLAUDE_CODE_SUBAGENT_MODEL": {
              "type": "string",
              "pattern": "^[ -~]+$",
              "minLength": 1,
              "maxLength": 256
            },
            "CLAUDE_CODE_MAX_CONTEXT_TOKENS": {
              "type": "string",
              "pattern": "^[ -~]+$",
              "minLength": 1,
              "maxLength": 256
            },
            "CLAUDE_CODE_MAX_OUTPUT_TOKENS": {
              "type": "string",
              "pattern": "^[ -~]+$",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "access",
        "model_id",
        "env"
      ],
      "additionalProperties": false
    },
    "resume_claude_session_id": {
      "$ref": "objects.json#/$defs/claude_session_id"
    },
    "restore": {
      "type": "object",
      "description": "restore the staged context (POST /v1/contexts/{id}/stage) and resume its conversation (ADR-072 section 7); not together with resume_claude_session_id",
      "properties": {
        "claude_session_id": {
          "$ref": "objects.json#/$defs/claude_session_id"
        },
        "object_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "note": {
          "type": "string",
          "description": "the runner's one sentence about what changed (new VM or device, checkpoint time, workspace restored fully, partly or not, a work VM must be requested again); the guest attaches it once, with the current session facts, to the first decorated hook answer of the resumed conversation (KOR-33)",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "claude_session_id",
        "object_id"
      ],
      "additionalProperties": false
    },
    "initial_prompt": {
      "type": "object",
      "properties": {
        "prompt_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "text": {
          "$ref": "objects.json#/$defs/text_256k"
        },
        "speaker": {
          "$ref": "objects.json#/$defs/speaker_line"
        }
      },
      "required": [
        "prompt_id",
        "text"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "memory_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cpu_quota": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "CPUQuota in percent of one CPU"
        },
        "tasks_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "runtime_max_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        }
      },
      "required": [
        "memory_max",
        "cpu_quota",
        "tasks_max",
        "runtime_max_sec"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "session_id",
    "task_id",
    "parent_session_id",
    "depth",
    "harness",
    "model",
    "limits"
  ],
  "additionalProperties": false
}
