{
  "name": "e2e-17-monitoring",
  "description": "E2E-17: a session that does a little work, asks the platform for a child session and stays alive: it writes a file into its workspace (workspace bytes for the session level), requests a subagent (subagent.request), waits for its answer (get_subagent_result) and answers. The child answers after 45 s, so it is sampled while it works (it ends after its answer); the parent stays idle with their units, so the runner samples device, VM, parent and child session while the monitoring checks run.",
  "steps": [
    {
      "id": "write",
      "expect": {
        "user_text_contains": "E2E17-MONITOR",
        "has_tools": true,
        "has_tool_result": false,
        "stream": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Writing the load report."
          },
          {
            "type": "tool_use",
            "name": "Write",
            "input": {
              "file_path": "${cwd}/load.md",
              "content": "# Load\nkz17-file-f2g6s8\n"
            }
          }
        ]
      }
    },
    {
      "id": "request-child",
      "expect": {
        "tool_result_contains": "load.md"
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Asking the platform for a summary."
          },
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "subagent.request",
              "params": {
                "purpose": "Summarize the load kz17-purpose-e3u5",
                "prompt": "E2E17-CHILD summarize the load"
              }
            }
          }
        ]
      }
    },
    {
      "id": "parent-wait",
      "expect": {
        "tool_result_contains": "\"status\":\"succeeded\""
      },
      "capture": {
        "child": {
          "regex": "\"result\":\\{\"session_id\":\"([0-9a-f-]{36})\"\\}",
          "source": "messages"
        }
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__get_subagent_result",
            "input": {
              "session_id": "${child}",
              "wait_seconds": 30
            }
          },
          {
            "type": "tool_use",
            "name": "mcp__platform__get_subagent_result",
            "input": {
              "session_id": "${child}",
              "wait_seconds": 30
            }
          },
          {
            "type": "tool_use",
            "name": "mcp__platform__get_subagent_result",
            "input": {
              "session_id": "${child}",
              "wait_seconds": 30
            }
          }
        ]
      }
    },
    {
      "id": "child",
      "expect": {
        "user_text_contains": "E2E17-CHILD",
        "has_tool_result": false,
        "tools_exclude": ["Agent", "Task"]
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Load summarized kz17-child-q4n7z2."
          }
        ]
      },
      "delay_ms": 45000
    },
    {
      "id": "answer",
      "expect": {
        "tool_result_contains": "Load summarized kz17-child-q4n7z2."
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "The load report is written kz17-answer-w9d4m1."
          }
        ]
      }
    }
  ],
  "side": [
    {
      "id": "title",
      "expect": {
        "has_tools": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Load"
          }
        ]
      }
    }
  ]
}
