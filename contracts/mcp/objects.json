      "pattern": "^agent\\.dfx\\.swiss notice: [1-9][0-9]{0,5} new item\\(s\\) available \\((whiteboard\\.entry, subagent\\.finished, operation\\.finished|whiteboard\\.entry, subagent\\.finished|whiteboard\\.entry, operation\\.finished|whiteboard\\.entry|subagent\\.finished, operation\\.finished|subagent\\.finished|operation\\.finished)\\)\\. Use mcp__platform__get_notifications to see them\\.$"
    },
