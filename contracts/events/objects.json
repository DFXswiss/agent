              "type": "string",
              "const": "github.commit"
            },
            "params": {
              "$ref": "../ops/objects.json#/$defs/params_github_commit"
            },
            "idempotency_key": {
              "$ref": "#/$defs/idempotency_key"
            }
          },
          "required": [
            "operation_id",
