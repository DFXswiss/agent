    {
      "id": "admitted-task",
      "expect": { "user_text_contains": "E2E40-ADMITTED", "has_tools": true, "has_tool_result": false, "stream": true },
      "reply": { "content": [{ "type": "text", "text": "Admitted member task kz40-answer-b4d6f8." }] }
