{
  "description": "Event kinds x scope x author kind with the right required at lh and at receipt (04-crypto.md section 4.3, CON-03). One row per allowed (kind, scope, author) combination; anything else is kind_not_allowed. header: rules for header fields (empty = \"\"; set = a UUID; scope_id = equals scope_id; target = the workgroup the org-level object refers to; author/device/entry/operation/read_target = the ref names that object). Fields not listed are not constrained by this table.",
  "rights": {
    "org_admin": "author is an admin of the org",
    "org_member_self": "author is an org member and ref == author",
    "wg_write": "author has write access to the workgroup",
    "device_assigned_wg": "author device is assigned to the workgroup",
    "device_assigned_wg_session": "author device is assigned to the workgroup and the session runs on it"
  },
  "notify_allowed": [
    "whiteboard.entry"
  ],
  "size_limits": {
    "default_ct_bytes": 262144,
    "session.terminal": 65536
  },
  "kinds": [
    {
      "kind": "org.profile",
      "scope": "org",
      "authors": [
        "user"
      ],
      "right": "org_admin",
      "header": {
        "wg": "empty"
      }
    },
    {
      "kind": "wg.profile",
      "scope": "org",
      "authors": [
        "user"
      ],
      "right": "org_admin",
      "header": {
        "wg": "target"
      }
    },
