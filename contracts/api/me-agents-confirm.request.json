{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/me-agents-confirm.request.json",
  "title": "POST /v1/me/agents request",
  "description": "Body of POST /v1/me/agents (11-agent-access.md section 4).",
  "type": "object",
  "properties": {
    "pairing_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "bundle_ct": {
      "$ref": "../common.json#/$defs/bundle_ct"
    },
    "label_ct": {
      "$ref": "../common.json#/$defs/bundle_ct"
    },
    "claim_hash": {
      "$ref": "../common.json#/$defs/b64u_32"
    },
    "handover_ct": {
      "$ref": "../common.json#/$defs/bundle_ct",
      "description": "the handover sealed to the agent (11-agent-access.md section 3): required for a remote pairing (400 handover_required), refused for a loopback pairing (400 handover_unexpected)"
    }
  },
  "required": [
    "pairing_id",
    "bundle_ct",
    "label_ct",
    "claim_hash"
  ],
  "additionalProperties": false
}
