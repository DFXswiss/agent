{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/orgs-create.request.json",
  "title": "POST /v1/orgs request",
  "description": "Body of POST /v1/orgs (03-api.md section 4.3).",
  "type": "object",
  "properties": {
    "genesis": {
      "$ref": "../common.json#/$defs/log_entry"
