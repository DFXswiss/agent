#!/usr/bin/env python3
"""VNC server of the work VM's screen for a person who takes over a check for humans (ADR-103 section 2).

The platform browser (`workvm-browser`) draws Chromium with a window into the X display `DISPLAY_NAME`. This helper
serves that display over RFB on the VM's loopback only, for one one-time password at a time:

  workvm-vnc start     reads the password (8 letters or digits) on stdin, starts x11vnc for exactly that password
                       and answers {"ok":true} once the port accepts; a running server is replaced
  workvm-vnc connect   joins stdin and stdout with the server's port (one viewer; the runner carries the bytes)
  workvm-vnc stop      ends the server and removes the password file
  workvm-vnc selftest  checks that x11vnc and Xvfb are installed

The runner calls it with `sudo -n` over the slot's `limactl shell` and treats every answer as untrusted. Test
overrides: WORKVM_VNC_DIR (state directory), WORKVM_VNC_PORT, WORKVM_VNC_DISPLAY, WORKVM_VNC_SERVER (the server
program), WORKVM_VNC_START=direct (no systemd unit).
"""

import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time

DIR = os.environ.get("WORKVM_VNC_DIR", "/run/workvm-vnc")
PORT = int(os.environ.get("WORKVM_VNC_PORT", "5900"))
DISPLAY_NAME = os.environ.get("WORKVM_VNC_DISPLAY", ":99")
SERVER = os.environ.get("WORKVM_VNC_SERVER", "x11vnc")
UNIT = "workvm-vnc"
PASSWORD_RE = re.compile(r"[A-Za-z0-9]{8}")
START_SECONDS = 10.0
CHUNK = 65536


def answer(value):
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def fail(text):
    sys.stderr.write(f"workvm-vnc: {text}\n")
    answer({"ok": False})
    return 1


def password_file():
    return os.path.join(DIR, "passwd")


def pid_file():
    return os.path.join(DIR, "server.pid")


def listening():
    try:
        with socket.create_connection(("127.0.0.1", PORT), timeout=1):
            return True
    except OSError:
        return False


def stop():
    if os.environ.get("WORKVM_VNC_START") != "direct":
        subprocess.run(["systemctl", "stop", f"{UNIT}.service"], capture_output=True, check=False)
    try:
        with open(pid_file(), encoding="ascii") as found:
            os.kill(int(found.read().strip()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    for path in (password_file(), pid_file()):
        try:
            os.remove(path)
        except OSError:
            pass
    deadline = time.monotonic() + START_SECONDS
    while listening() and time.monotonic() < deadline:
        time.sleep(0.1)
    return 0


def start():
    password = sys.stdin.readline().strip()
    if not PASSWORD_RE.fullmatch(password):
        return fail("the password must be 8 letters or digits")
    stop()
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    os.chmod(DIR, 0o700)
    stored = subprocess.run(
        [SERVER, "-storepasswd", password, password_file()], capture_output=True, check=False
    )
    if stored.returncode != 0:
        return fail("the password file was not written")
    os.chmod(password_file(), 0o600)
    argv = [
        SERVER,
        "-display", DISPLAY_NAME,
        "-rfbport", str(PORT),
        "-localhost",
        "-rfbauth", password_file(),
        "-forever",
        "-shared",
        "-noxdamage",
        "-quiet",
    ]
    if os.environ.get("WORKVM_VNC_START") == "direct":
        process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        with open(pid_file(), "w", encoding="ascii") as written:
            written.write(f"{process.pid}\n")
    else:
        started = subprocess.run(
            ["systemd-run", f"--unit={UNIT}", "--collect", "--quiet", *argv], capture_output=True, check=False
        )
        if started.returncode != 0:
            return fail("the server did not start")
    deadline = time.monotonic() + START_SECONDS
    while not listening():
        if time.monotonic() >= deadline:
            stop()
            return fail("the server does not accept connections")
        time.sleep(0.1)
    answer({"ok": True})
    return 0


def connect():
    try:
        server = socket.create_connection(("127.0.0.1", PORT), timeout=START_SECONDS)
    except OSError:
        sys.stderr.write("workvm-vnc: no server\n")
        return 1
    server.settimeout(None)
    stdin, stdout = sys.stdin.buffer.raw, sys.stdout.buffer.raw

    def upstream():
        try:
            while True:
                data = os.read(stdin.fileno(), CHUNK)
                if not data:
                    break
                server.sendall(data)
        except OSError:
            pass
        try:
            server.shutdown(socket.SHUT_WR)
        except OSError:
            pass

    threading.Thread(target=upstream, daemon=True).start()
    try:
        while True:
            data = server.recv(CHUNK)
            if not data:
                break
            view = memoryview(data)
            while view:
                view = view[os.write(stdout.fileno(), view):]
    except OSError:
        pass
    server.close()
    return 0


def selftest():
    missing = [name for name in (SERVER, "Xvfb") if shutil.which(name) is None]
    if missing:
        return fail("missing " + " ".join(missing))
    answer({"ok": True})
    return 0


COMMANDS = {"start": start, "connect": connect, "stop": stop, "selftest": selftest}


def main(argv):
    if len(argv) != 2 or argv[1] not in COMMANDS:
        sys.stderr.write("usage: workvm-vnc start|connect|stop|selftest\n")
        return 2
    return COMMANDS[argv[1]]()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
