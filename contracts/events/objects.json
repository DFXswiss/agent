    "github_next_step": {
      "type": "object",
      "description": "github_access (KOR-65): the one step that gives the connection access to the repository. connect: connect GitHub again with the device flow that reaches every repository of the account; install_app: install the GitHub App for the owner (url); approve_app: request or grant the organisation's approval of the OAuth App (url); authorize_sso: authorise the token for the organisation's SAML single sign-on (url); new_token: create a token that reaches the owner (url, pre-filled) and store it; check_access: the account itself has no access - open the repository at GitHub (url) and ask its owner, or connect another account. url is built by the runner from its configured GitHub web URL and checked values only",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "connect",
            "install_app",
            "approve_app",
            "authorize_sso",
            "new_token",
            "check_access"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$",
          "description": "the owner of the repository (account or organisation)"
        },
        "url": {
          "type": "string",
          "description": "https URL on the GitHub web host, or http on the loopback host (hermetic doubles)",
          "pattern": "^(https://[!-~]{1,2040}|http://(127\\.0\\.0\\.1|localhost)(:[0-9]{1,5})?(/[!-~]{0,2000})?)$",
          "maxLength": 2048
        }
      },
      "required": [
        "action",
        "owner"
      ],
      "additionalProperties": false
    }
  }
}
