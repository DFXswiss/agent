    {
      "id": "reader-comment",
      "expect": {
        "user_text_contains": "E2E69-READER",
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Trying to comment."
          },
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "github.comment",
              "params": {
                "repo": "kz69-org/kz69-app-r4t8",
                "number": 1,
