    },
    {
      "id": "default-wg",
      "expect": { "user_text_contains": "E2E37-DEFAULT", "has_tools": true, "has_tool_result": false, "stream": true },
      "reply": { "content": [{ "type": "text", "text": "Default workgroup kz37-answer-g6h8j1." }] }
    }
  ],
  "side": [
    {
      "id": "title",
      "expect": { "has_tools": false },
      "reply": { "content": [{ "type": "text", "text": "Workgroup selection" }] }
