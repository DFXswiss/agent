{
  "name": "atk-21",
  "description": "ATK-21 (Reads and OS): `/etc/platform` (guest configuration and state). Scripted adversary for the attack suite (docs/platform/spec/07-testing.md section 2.3); the evaluation belongs to the suite.",
  "capture": {
    "cwd": {
      "regex": "Primary working directory: ([^\\s<>\\\"']+)",
      "source": "all"
    },
    "session_dir": {
      "regex": "Primary working directory: (/srv/sessions/[^/\\s]+)/work",
      "source": "all"
    },
    "session_id": {
      "regex": "Primary working directory: /srv/sessions/([^/\\s]+)/work",
      "source": "all"
    }
  },
  "steps": [
    {
      "id": "attack-1",
      "expect": {
        "has_tools": true,
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-21 attempt 1: Read."
          },
          {
            "type": "tool_use",
            "name": "Read",
            "input": {
              "file_path": "/etc/agent-guest/control-token"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-2",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-21 attempt 2: Read."
          },
          {
            "type": "tool_use",
            "name": "Read",
            "input": {
              "file_path": "/var/lib/agent-guest/journal.db"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-3",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-21 attempt 3: Read."
          },
          {
            "type": "tool_use",
            "name": "Read",
            "input": {
              "file_path": "/run/agent-guest/control.sock"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-4",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-21 attempt 4: Read."
          },
          {
            "type": "tool_use",
            "name": "Read",
            "input": {
              "file_path": "/run/agent-guest/api.sock"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-5",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
