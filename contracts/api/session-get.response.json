{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/session-get.response.json",
  "title": "GET /v1/sessions/{session} response",
  "description": "Body of a successful response to GET /v1/sessions/{session} (03-api.md section 4.6).",
  "type": "object",
  "properties": {
    "session": {
      "$ref": "objects.json#/$defs/session_row"
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "objects.json#/$defs/session_transition"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "objects.json#/$defs/usage"
        },
        {
          "type": "null"
        }
      ]
    },
    "vm": {
      "anyOf": [
        {
          "$ref": "objects.json#/$defs/vm_row"
        },
        {
          "type": "null"
        }
      ]
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/uuid"
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "session",
    "transitions",
    "usage",
    "vm",
    "children"
  ],
  "additionalProperties": false
}
