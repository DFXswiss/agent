{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/credentials/claude_subscription.json",
  "title": "credential body claude_subscription",
  "description": "Plaintext body of the credential kind claude_subscription inside the record ciphertext (04-crypto.md section 4.4).",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "printable ASCII without spaces",
      "pattern": "^[!-~]+$",
      "minLength": 1,
      "maxLength": 4096
    },
    "email": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[!-?A-~]{1,64}@[A-Za-z0-9-]{1,63}(\\.[A-Za-z0-9-]{1,63}){0,8}$",
          "maxLength": 254
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "const": "setup_token"
    }
  },
  "required": [
    "token",
    "email",
    "kind"
  ],
  "additionalProperties": false
}
