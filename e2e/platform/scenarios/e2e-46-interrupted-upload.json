{
  "name": "e2e-46-interrupted-upload",
  "description": "E2E-40 (KOR-33, ADR-059 sections 4-5): session 1 writes ledger.md and is ended (its final checkpoint is complete); session 2 continues the conversation (restored) and writes second.md, then ends; the hub's checkpoints of session 2 are turned back into uploads without commit (an upload interrupted before its commit). The follow-up continues from session 1's complete checkpoint: the first turn is in the request, the second is not (the spec checks the journal), and ledger.md is read from the restored workspace.",
  "steps": [
    {
      "id": "work",
      "expect": { "user_text_contains": "E2E40-WORK", "has_tools": true, "has_tool_result": false, "stream": true },
      "reply": {
        "content": [
          { "type": "text", "text": "I will keep the ledger first." },
          {
            "type": "tool_use",
            "name": "Write",
            "input": { "file_path": "${cwd}/ledger.md", "content": "# Ledger\nkz40r-file-p3w8n5c1\n" }
          }
        ]
      }
    },
    {
      "id": "worked",
      "expect": { "tool_result_is_error": false, "tool_result_contains": "ledger.md" },
      "reply": { "content": [{ "type": "text", "text": "The ledger is written kz40r-answer-g6t2m9x4." }] }
    },
    {
      "id": "more",
      "expect": { "user_text_contains": "E2E40-MORE", "has_tool_result": false, "min_messages": 5 },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "Write",
            "input": { "file_path": "${cwd}/second.md", "content": "kz40r-second-file-j2v7r4d9\n" }
          }
        ]
      }
    },
    {
      "id": "more-done",
      "expect": { "tool_result_is_error": false, "tool_result_contains": "second.md" },
      "reply": { "content": [{ "type": "text", "text": "The second file is written kz40r-second-answer-u5e8h3w6." }] }
    },
    {
      "id": "follow-read",
      "expect": { "user_text_contains": "E2E40-AGAIN", "has_tool_result": false, "min_messages": 5 },
      "reply": {
        "content": [
          { "type": "text", "text": "Reading the ledger again." },
          { "type": "tool_use", "name": "Read", "input": { "file_path": "${cwd}/ledger.md" } }
        ]
      }
    },
    {
      "id": "follow-answer",
      "expect": { "tool_result_is_error": false, "tool_result_contains": "kz40r-file-p3w8n5c1" },
      "reply": { "content": [{ "type": "text", "text": "Continued: the ledger still holds kz40r-file-p3w8n5c1." }] }
    }
  ],
  "side": [
    {
      "id": "title",
      "expect": { "has_tools": false },
      "reply": { "content": [{ "type": "text", "text": "Ledger" }] }
    }
  ]
}
