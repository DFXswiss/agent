{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/requests/objects.json",
  "title": "device request definitions",
  "description": "Shared definitions of the device request and response bodies (05-runner.md section 11).",
  "$defs": {
    "failure_code": {
      "type": "string",
      "description": "closed list of failure codes of device responses: timeout (flow or poll expired), busy (another request of this kind is active), credential_missing (e.g. no mailbox credential), code_invalid (authorization code refused), login_cli_failed, token_invalid (unexpected token format), upstream_error (GitHub/Anthropic/IMAP refused), upstream_unreachable, device_shutdown, token_refused (GitHub refused a stored token: revoked or unknown), scope_missing (a classic token without the repo scope; a Claude subscription login whose scopes lack user:profile or user:inference, ADR-092), sso_required (an organisation requires SSO authorisation of the token), flow_unavailable (the asked GitHub device flow is not set up on the device, KOR-65), github_not_connected (github.pull_status: no GitHub identity the requester may use, ADR-084 section 2), forbidden (github.pull_status: the device does not serve the workgroup or the requester cannot read it), no_screen (vnc.open: no sandbox of the owner with a screen waits for a human under the named target, ADR-103)",
      "enum": [
        "timeout",
        "busy",
        "credential_missing",
        "code_invalid",
        "login_cli_failed",
        "token_invalid",
        "upstream_error",
        "upstream_unreachable",
        "device_shutdown",
        "token_refused",
        "scope_missing",
        "sso_required",
        "flow_unavailable",
        "github_not_connected",
        "forbidden",
        "no_screen"
      ]
    },
    "github_body": {
      "description": "Plaintext body of the credential kind github inside the record ciphertext (04-crypto.md section 4.4); one record is one GitHub identity (ADR-078).",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "printable ASCII without spaces",
          "pattern": "^[!-~]+$",
          "minLength": 1,
          "maxLength": 4096
        },
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$"
        },
        "user_id": {
          "$ref": "../common.json#/$defs/positive"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9:_-]{1,64}$"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "created_at": {
          "$ref": "../common.json#/$defs/time"
        },
        "source": {
          "type": "string",
          "enum": [
            "device_flow",
            "token",
            "operator"
          ],
          "description": "how the connection was made: the GitHub App device flow, an existing token stored by the owner (KOR-25) or the operator's token stored as an organization's account (KOR-47); missing on records written before"
        },
        "name": {
          "type": "string",
          "description": "the account's display name at GitHub (KOR-47), printable ASCII without angle brackets; left out otherwise",
          "pattern": "^[ -;=?-~]{1,255}$"
        },
        "signing_key": {
          "type": "object",
          "description": "the identity's own SSH signing key (KOR-47, ADR-078 section 5): Ed25519 seed and its OpenSSH public key, registered at GitHub as a signing key of the account",
          "properties": {
            "alg": {
              "type": "string",
              "const": "ssh-ed25519"
            },
            "seed": {
              "$ref": "../common.json#/$defs/b64u_32"
            },
            "public": {
              "type": "string",
              "pattern": "^ssh-ed25519 [A-Za-z0-9+/]{68}( [!-~]{1,64})?$"
            },
            "github_key_id": {
              "$ref": "../common.json#/$defs/positive"
            }
          },
          "required": [
            "alg",
            "seed",
            "public"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "token",
        "login",
        "user_id",
        "scopes",
        "created_at"
      ],
      "additionalProperties": false
    },
    "pull_address": {
      "type": "object",
      "description": "a pull request by repository (owner/name) and number (github.pull_status)",
      "properties": {
        "repo": {
          "$ref": "../ops/objects.json#/$defs/repo"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "additionalProperties": false
    },
    "pull_state": {
      "description": "the state of one pull request read by github.pull_status (ADR-084 section 2): found with GitHub's fields (mergeable null while GitHub still computes it; a conflict is mergeable false; mergeable_state is display only; head_repo null when the head repository is gone), or not found with the reason",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "repo": {
              "$ref": "../ops/objects.json#/$defs/repo"
            },
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "found": {
              "type": "boolean",
              "const": true
            },
            "title": {
              "type": "string",
              "maxLength": 1024
            },
            "state": {
              "type": "string",
              "enum": [
                "open",
                "closed"
              ]
            },
            "draft": {
              "type": "boolean"
            },
            "merged": {
              "type": "boolean"
            },
            "mergeable": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "mergeable_state": {
              "type": "string",
              "pattern": "^[a-z_]{1,32}$"
            },
            "head_ref": {
              "$ref": "../ops/objects.json#/$defs/branch"
            },
            "head_sha": {
              "$ref": "../ops/objects.json#/$defs/sha"
            },
            "head_repo": {
              "anyOf": [
                {
                  "$ref": "../ops/objects.json#/$defs/repo"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_ref": {
              "$ref": "../ops/objects.json#/$defs/branch"
            },
            "url": {
              "$ref": "../ops/objects.json#/$defs/url"
            },
            "updated_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
            }
          },
          "required": [
            "repo",
            "number",
            "found",
            "title",
            "state",
            "draft",
            "merged",
            "mergeable",
            "mergeable_state",
            "head_ref",
            "head_sha",
            "head_repo",
            "base_ref",
            "url",
            "updated_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "repo": {
              "$ref": "../ops/objects.json#/$defs/repo"
            },
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "found": {
              "type": "boolean",
              "const": false
            },
            "code": {
              "type": "string",
              "enum": [
                "not_found",
                "repo_not_accessible",
                "repo_not_allowed",
                "upstream_error"
              ]
            }
          },
          "required": [
            "repo",
            "number",
            "found",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
