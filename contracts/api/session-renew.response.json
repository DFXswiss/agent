    "key_id": {
      "$ref": "../common.json#/$defs/session_key_id"
    },
    "expires_at": {
      "$ref": "../common.json#/$defs/time"
    }
  },
  "required": [
    "key_id",
    "expires_at"
  ],
  "additionalProperties": false
}
