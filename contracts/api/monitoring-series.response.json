{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/monitoring-series.response.json",
  "title": "GET /v1/monitoring/series response",
  "description": "points [[ts, value]]; value null where no sample exists",
  "type": "object",
  "properties": {
    "points": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "$ref": "../common.json#/$defs/time"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 0,
      "maxItems": 20000
    }
  },
  "required": [
    "points"
  ],
  "additionalProperties": false
}
