{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/tasks-create.request.json",
  "title": "POST /v1/tasks request",
  "description": "events = [task.meta, prompt] (03-api.md section 4.6); placement: the chosen device and VM (ADR-060 section 6)",
  "type": "object",
  "properties": {
    "task_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "wg_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/event"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "placement": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "../common.json#/$defs/uuid"
        },
        "vm_id": {
          "$ref": "../common.json#/$defs/vm_id"
        }
      },
      "required": [
        "device_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "task_id",
    "wg_id",
    "events"
  ],
  "additionalProperties": false
}
