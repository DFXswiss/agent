{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/requests/credential.check.response.json",
  "title": "device response body credential.check",
  "description": "Plaintext body of a device response to credential.check (seq 1..n, final on the last; 05-runner.md section 11). Never contains a secret.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "done"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "step",
        "valid"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "const": "failed"
        },
        "code": {
          "$ref": "objects.json#/$defs/failure_code"
        }
      },
      "required": [
        "step",
        "code"
      ],
      "additionalProperties": false
    }
  ]
}
