{
  "description": "Closed list of the view types of the web client's anonymous UI health report (POST /v1/telemetry/ui, ADR-081 section 5, 03-api.md section 4.11, 08-monitoring.md section 6.1). A view type names a route pattern of web/src/ui/screens/*/routes.tsx (a task or session tab after the dot), never an ID. `patterns` maps each type to its route patterns (`#<tab>`: the tab of that screen); routes without a type (the start redirect, the not-found page) and every type a hub does not know yet are counted as `fallback`. `buckets_ms`: the longest blocked interval of a report is bucket i when it is at least buckets_ms[i] and below buckets_ms[i+1] (the last bucket is open). `limits`: the hub clamps count, blocked_ms and max_bucket of each view to these values, refuses more than views_per_report views or a body above body_bytes; a version other than the one the hub serves (its own version, the web client's config.version) is counted as `other`.",
  "views": [
    "home",
    "tasks",
    "tasks.overview",
    "task.terminal",
    "task.chat",
    "task.sessions",
    "task.pulls",
    "task.operations",
    "task.charges",
    "task.whiteboard",
    "task.audit",
    "session.terminal",
    "session.chat",
    "session.children",
    "session.browser",
    "whiteboard",
    "notifications",
    "community",
    "members",
    "devices",
    "github",
    "workgroups",
    "pulls",
    "wg-settings",
    "monitoring",
    "audit",
    "settings",
    "platform-invites",
    "security",
    "invite",
    "login",
    "recover",
    "connect",
    "other"
  ],
  "fallback": "other",
  "patterns": {
    "home": ["/o/:org"],
    "tasks": ["/o/:org/w/:wg"],
    "tasks.overview": ["/o/:org/tasks"],
    "task.terminal": ["/o/:org/t/:task#terminal"],
    "task.chat": ["/o/:org/t/:task#chat"],
    "task.sessions": ["/o/:org/t/:task#sessions"],
    "task.pulls": ["/o/:org/t/:task#pulls"],
    "task.operations": ["/o/:org/t/:task#operations"],
    "task.charges": ["/o/:org/t/:task#charges"],
    "task.whiteboard": ["/o/:org/t/:task#whiteboard"],
    "task.audit": ["/o/:org/t/:task#audit"],
    "session.terminal": ["/o/:org/s/:session#terminal"],
    "session.chat": ["/o/:org/s/:session#chat"],
    "session.children": ["/o/:org/s/:session#children"],
    "session.browser": ["/o/:org/s/:session#browser"],
    "whiteboard": ["/o/:org/whiteboard", "/o/:org/w/:wg/whiteboard"],
    "notifications": ["/notifications"],
    "community": ["/community"],
    "members": ["/o/:org/members"],
    "devices": ["/o/:org/devices"],
    "github": ["/o/:org/github"],
    "workgroups": ["/o/:org/workgroups"],
    "pulls": ["/o/:org/pulls", "/o/:org/w/:wg/pulls"],
    "wg-settings": ["/o/:org/w/:wg/settings"],
    "monitoring": ["/o/:org/monitoring"],
    "audit": ["/o/:org/audit"],
    "settings": ["/settings", "/subscriptions"],
    "platform-invites": ["/platform/invites"],
    "security": ["/security"],
    "invite": ["/invite"],
    "login": ["/login"],
    "recover": ["/recover"],
    "connect": ["/connect"],
    "other": ["/", "*", "/support", "/support/:org/:wg", "/support/:org/:wg/:task"]
  },
  "buckets_ms": [200, 500, 1000, 2000, 5000, 10000, 30000],
  "limits": {
    "count": 100000,
    "blocked_ms": 3600000,
    "max_bucket": 6,
    "views_per_report": 64,
    "body_bytes": 8192
  }
}
