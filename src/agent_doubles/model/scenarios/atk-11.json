{
  "name": "atk-11",
  "description": "ATK-11 (Tools and execution): copied binary. Scripted adversary for the attack suite (docs/platform/spec/07-testing.md section 2.3); the evaluation belongs to the suite.",
  "capture": {
    "cwd": {
      "regex": "Primary working directory: ([^\\s<>\\\"']+)",
      "source": "all"
    },
    "session_dir": {
      "regex": "Primary working directory: (/srv/sessions/[^/\\s]+)/work",
      "source": "all"
    },
    "session_id": {
      "regex": "Primary working directory: /srv/sessions/([^/\\s]+)/work",
      "source": "all"
    }
  },
  "steps": [
    {
      "id": "attack-1",
      "expect": {
        "has_tools": true,
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-11 attempt 1: Bash."
          },
          {
            "type": "tool_use",
            "name": "Bash",
            "input": {
              "command": "cp /usr/bin/id ${cwd}/id && chmod +x ${cwd}/id && ${cwd}/id",
              "description": "run a command"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-2",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-11 attempt 2: Bash."
          },
          {
            "type": "tool_use",
            "name": "Bash",
            "input": {
              "command": "cp /usr/bin/id /tmp/id && /tmp/id",
              "description": "run a command"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "finish",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-11 finished."
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 10
        }
      }
    }
  ],
  "side": [
    {
      "id": "background",
      "expect": {
        "has_tools": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Session"
          }
        ]
      }
    }
  ]
}
