        "user"
      ],
      "right": "org_member_self",
      "header": {
        "wg": "empty",
        "ref": "author"
      }
    },
    {
      "kind": "device.profile",
      "scope": "org",
      "authors": [
        "user"
      ],
      "right": "org_admin",
      "header": {
