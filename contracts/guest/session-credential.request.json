{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/guest/session-credential.request.json",
  "title": "guest PUT /v1/sessions/{id}/credential request",
  "description": "Request of PUT /v1/sessions/{id}/credential (03-api.md section 7.1).",
  "type": "object",
  "properties": {
    "upstream_base_url": {
      "type": "string",
      "description": "https, or http to a loopback double in tests",
      "pattern": "^(https://[!-~]+|http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]{1,5})?(/[!-~]*)?)$",
      "maxLength": 2048
    },
    "auth_header": {
      "type": "string",
      "enum": [
        "x-api-key",
        "authorization"
      ]
    },
    "auth_value": {
      "type": "string",
      "description": "header value (e.g. 'Bearer <token>'); memory only",
      "pattern": "^[!-~]+( [!-~]+)?$",
      "minLength": 1,
      "maxLength": 16384
    },
    "extra_headers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "minLength": 1,
            "maxLength": 64
          },
          "value": {
            "type": "string",
            "pattern": "^[ -~]*$",
            "minLength": 0,
            "maxLength": 1024
          }
        },
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32,
      "description": "additional upstream headers (lower-case token names, printable values); the guest refuses the reserved names of guest/INDEX.json#/reserved_headers"
    },
    "provider_allowlist": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/label_text"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "access": {
      "$ref": "../common.json#/$defs/model_access",
      "description": "access kind of the credential: selects the injection of 05-runner.md section 10.2 (subscription adds anthropic-beta oauth-2025-04-20)"
    },
    "models_allowed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model_id": {
            "$ref": "../common.json#/$defs/model_id"
          },
          "context_window": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          }
        },
        "required": [
          "model_id",
          "context_window"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64,
      "description": "catalog allow-list of the access kind (model-catalog.json access.<kind>.allowed) with each model's catalog context_window (journal usage context_window_tokens); any other model is refused with model_not_allowed"
    },
    "budget": {
      "type": "object",
      "description": "daily platform budget of the organization (device/state platform_budget, only for the platform access); absent = unlimited. The gateway refuses with 429 budget_exceeded once spent_usd plus the cost it observed since this provisioning reaches usd_per_day. spent_usd is the hub's amount plus the cost of the device's usage items the hub had not counted in it; journal_through (optional, contracts/changes/KOR-10.md) is the last journal seq of this guest whose usage the device had taken into that amount: the gateway carries its own cost above it across the renewal",
      "properties": {
        "usd_per_day": {
          "type": "number",
          "minimum": 0
        },
        "spent_usd": {
          "type": "number",
          "minimum": 0
        },
        "journal_through": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "usd_per_day",
        "spent_usd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "upstream_base_url",
    "auth_header",
    "auth_value",
    "extra_headers",
    "access",
    "models_allowed"
  ],
  "additionalProperties": false
}
