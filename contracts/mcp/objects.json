        },
        {
          "type": "string",
          "pattern": "^Tool [A-Za-z0-9_.:-]{1,128} is forbidden in agent\\.dfx\\.swiss sessions\\. Request actions through the platform tools \\(mcp__platform__request_operation\\)\\.$"
