# Coverage of the platform packages (docs/platform/spec/07-testing.md section 3): hub, runner, guest, doubles and the
# agent tool together, one gate of 100 % lines and branches (INF-06). The legacy configuration [tool.coverage] in
# pyproject.toml (source agent_cli) is separate and unchanged.
[run]
source =
    agent_hub
    agent_runner
    agent_guest
    agent_doubles
    agent_platform
    scripts/probes/probelib
    deploy/monitoring/agent_monitoring
branch = true
parallel = true
patch = subprocess

[paths]
source =
    src/
    /opt/agent-guest/src/
    */agent/src/

[report]
fail_under = 100
show_missing = true
skip_covered = true
exclude_also =
    if __name__ == "__main__":
