{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/device-pull.request.json",
  "title": "GET /v1/device/pull request",
  "description": "query parameters",
  "type": "object",
  "properties": {
    "cursor": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "scope_id:seq",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:(0|[1-9][0-9]{0,15})$"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "kinds": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z]+)?(,[a-z]+(\\.[a-z]+)?){0,31}$",
      "maxLength": 1024
    },
    "limit": {
      "$ref": "../common.json#/$defs/q_limit_log"
    }
  },
  "required": [],
  "additionalProperties": false
}
