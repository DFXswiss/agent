{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/subscriptions-usage.response.json",
  "title": "GET /v1/me/subscriptions/usage response",
  "description": "Who used how much of which Claude subscription (03-api.md section 4.8, ADR-100): every subscription of the caller with every person and the total, and the subscriptions of other owners the caller used in the span with the caller's own row only (`total` null). Numbers only. `estimated_percent` is the person's share of the tokens times the measured use of the window: an estimate, because the provider measures the quota per subscription only.",
  "type": "object",
  "properties": {
    "period": {
      "type": "string",
      "enum": ["five_hour", "week", "range"]
    },
    "since": {
      "$ref": "../common.json#/$defs/time"
    },
    "until": {
      "$ref": "../common.json#/$defs/time"
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subscription_usage"
      },
      "minItems": 0,
      "maxItems": 200
    }
  },
  "required": ["period", "subscriptions"],
  "additionalProperties": false,
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "figures": {
      "type": "object",
      "properties": {
        "requests": { "$ref": "#/$defs/count" },
        "input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "cache_read_tokens": { "$ref": "#/$defs/count" },
        "cache_write_tokens": { "$ref": "#/$defs/count" },
        "tokens": { "$ref": "#/$defs/count" },
        "sessions": { "$ref": "#/$defs/count" }
      },
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "tokens",
        "sessions"
      ],
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "properties": {
        "user_id": { "$ref": "../common.json#/$defs/uuid" },
        "requests": { "$ref": "#/$defs/count" },
        "input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "cache_read_tokens": { "$ref": "#/$defs/count" },
        "cache_write_tokens": { "$ref": "#/$defs/count" },
        "tokens": { "$ref": "#/$defs/count" },
        "sessions": { "$ref": "#/$defs/count" },
        "token_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "estimated_percent": {
          "oneOf": [{ "$ref": "#/$defs/percent" }, { "type": "null" }]
        }
      },
      "required": [
        "user_id",
        "requests",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "tokens",
        "sessions",
        "token_share",
        "estimated_percent"
      ],
      "additionalProperties": false
    },
    "measured": {
      "type": "object",
      "properties": {
        "used_percent": { "$ref": "#/$defs/percent" },
        "resets_at": { "$ref": "../common.json#/$defs/time" },
        "fetched_at": { "$ref": "../common.json#/$defs/time" }
      },
      "required": ["used_percent", "resets_at", "fetched_at"],
      "additionalProperties": false
    },
    "subscription_usage": {
      "type": "object",
      "properties": {
        "subscription_id": { "$ref": "../common.json#/$defs/uuid" },
        "owner_id": { "$ref": "../common.json#/$defs/uuid" },
        "primary": { "type": "boolean" },
        "own": { "type": "boolean" },
        "since": { "$ref": "../common.json#/$defs/time" },
        "until": { "$ref": "../common.json#/$defs/time" },
        "measured": {
          "oneOf": [{ "$ref": "#/$defs/measured" }, { "type": "null" }]
        },
        "total": {
          "oneOf": [{ "$ref": "#/$defs/figures" }, { "type": "null" }]
        },
        "people": {
          "type": "array",
          "items": { "$ref": "#/$defs/person" },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": ["subscription_id", "owner_id", "primary", "own", "since", "until", "measured", "total", "people"],
      "additionalProperties": false
    }
  }
}
