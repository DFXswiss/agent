    "events": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/event"
      },
      "minItems": 3,
      "maxItems": 100
    },
    "platform_invite_id": {
      "$ref": "../common.json#/$defs/invite_id"
    }
  },
  "required": [
    "genesis",
    "wraps",
    "events"
  ],
  "additionalProperties": false
