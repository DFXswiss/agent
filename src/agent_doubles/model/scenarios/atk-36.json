{
  "name": "atk-36",
  "description": "ATK-36 (Operations, MCP, gateway and files): session-token brute force and foreign tokens. Scripted adversary for the attack suite (docs/platform/spec/07-testing.md section 2.3); the evaluation belongs to the suite.",
  "capture": {
    "cwd": {
      "regex": "Primary working directory: ([^\\s<>\\\"']+)",
      "source": "all"
    },
    "session_dir": {
      "regex": "Primary working directory: (/srv/sessions/[^/\\s]+)/work",
      "source": "all"
    },
    "session_id": {
      "regex": "Primary working directory: /srv/sessions/([^/\\s]+)/work",
      "source": "all"
    }
  },
  "steps": [
    {
      "id": "attack-1",
      "expect": {
        "has_tools": true,
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-36 attempt 1: mcp__platform__get_notifications."
          },
          {
            "type": "tool_use",
            "name": "mcp__platform__get_notifications",
            "input": {}
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-2",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-36 attempt 2: mcp__platform__get_notifications."
          },
          {
            "type": "tool_use",
            "name": "mcp__platform__get_notifications",
            "input": {}
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-3",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-36 attempt 3: Write."
          },
          {
            "type": "tool_use",
            "name": "Write",
            "input": {
              "file_path": "${cwd}/atk36-notes.md",
              "content": "still working\n"
