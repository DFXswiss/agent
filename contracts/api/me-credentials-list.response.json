{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/me-credentials-list.response.json",
  "title": "GET /v1/me/credentials response",
  "description": "Body of a successful response to GET /v1/me/credentials (03-api.md section 4.8).",
  "type": "object",
  "properties": {
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "../common.json#/$defs/credential_kind"
          },
          "version": {
            "$ref": "../common.json#/$defs/positive"
          },
          "epoch": {
            "$ref": "../common.json#/$defs/epoch"
          },
          "updated_at": {
            "$ref": "../common.json#/$defs/time"
          }
        },
        "required": [
          "kind",
          "version",
          "epoch",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4
    }
  },
  "required": [
    "credentials"
  ],
  "additionalProperties": false
}
