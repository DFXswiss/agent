{
  "name": "e2e-51-shared-task-github",
  "description": "E2E-51 (HOT-14): Ada's task, Wendy writes in it. Ada's plain first prompt is answered with text. Wendy's prompt asks for a comment: the session requests github.comment at once; the runner holds it for Wendy (who has no GitHub) and the session waits with get_operation until Wendy connected her own account from the card, then answers. Ada's next prompt asks for another comment, which runs at once with Ada's account.",
  "steps": [
    {
      "id": "first",
      "expect": {
        "user_text_contains": "E2E51-ADA-FIRST",
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Ready for the shared work kz51-answer-a-q4m8."
          }
        ]
      }
    },
    {
      "id": "wendy",
      "expect": {
        "user_text_contains": "E2E51-WENDY",
        "has_tool_result": false,
        "tools_include": ["mcp__platform__request_operation", "mcp__platform__get_operation"]
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "github.comment",
              "params": {
                "repo": "octo-org/shared",
                "number": 1,
                "body": "Reviewed by Wendy kz51-comment-w-t6r2"
              }
            }
          }
        ]
      }
    },
    {
      "id": "wait",
      "expect": {
        "tool_result_contains": "\"operation_id\":\""
      },
      "capture": {
        "op": {
          "regex": "\"operation_id\":\"([0-9a-f-]{36})\"",
          "source": "messages"
        }
      },
      "delay_ms": 10000,
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__get_operation",
            "input": {
              "operation_id": "${op}",
              "wait_seconds": 30
            }
          },
          {
            "type": "tool_use",
            "name": "mcp__platform__get_operation",
            "input": {
              "operation_id": "${op}",
              "wait_seconds": 30
            }
          },
          {
            "type": "tool_use",
            "name": "mcp__platform__get_operation",
            "input": {
              "operation_id": "${op}",
              "wait_seconds": 30
            }
          }
        ]
      }
    },
    {
      "id": "wendy-done",
      "expect": {
        "tool_result_contains": "\"comment_id\""
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Wendy's comment is posted kz51-answer-w-c9j3."
          }
        ]
      }
    },
    {
      "id": "ada",
      "expect": {
        "user_text_contains": "E2E51-ADA-AGAIN",
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "tool_use",
            "name": "mcp__platform__request_operation",
            "input": {
              "type": "github.comment",
              "params": {
                "repo": "octo-org/shared",
                "number": 1,
                "body": "Approved by Ada kz51-comment-a-b5n7"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ada-done",
      "expect": {
        "tool_result_contains": "\"comment_id\""
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Ada's comment is posted kz51-answer-d-x2k6."
          }
        ]
      }
    }
  ],
  "side": [
    {
      "id": "title",
      "expect": {
        "has_tools": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Shared work"
          }
        ]
      }
    }
  ]
}
