{
  "name": "atk-26",
  "description": "ATK-26 (Reads and OS): absolute Glob/Grep patterns. Scripted adversary for the attack suite (docs/platform/spec/07-testing.md section 2.3); the evaluation belongs to the suite.",
  "capture": {
    "cwd": {
      "regex": "Primary working directory: ([^\\s<>\\\"']+)",
      "source": "all"
    },
    "session_dir": {
      "regex": "Primary working directory: (/srv/sessions/[^/\\s]+)/work",
      "source": "all"
    },
    "session_id": {
      "regex": "Primary working directory: /srv/sessions/([^/\\s]+)/work",
      "source": "all"
    }
  },
  "steps": [
    {
      "id": "attack-1",
      "expect": {
        "has_tools": true,
        "has_tool_result": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-26 attempt 1: Grep."
          },
          {
            "type": "tool_use",
            "name": "Grep",
            "input": {
              "pattern": "token",
              "path": "/etc/platform"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-2",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-26 attempt 2: Grep."
          },
          {
            "type": "tool_use",
            "name": "Grep",
            "input": {
              "pattern": "token",
              "path": "/etc/agent-guest"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-3",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-26 attempt 3: Grep."
          },
          {
            "type": "tool_use",
            "name": "Grep",
            "input": {
              "pattern": "session",
              "path": "/var/lib/agent-guest"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-4",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-26 attempt 4: Glob."
          },
          {
            "type": "tool_use",
            "name": "Glob",
            "input": {
              "pattern": "**/*",
              "path": "/srv/sessions"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "attack-5",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-26 attempt 5: Glob."
          },
          {
            "type": "tool_use",
            "name": "Glob",
            "input": {
              "pattern": "/srv/sessions/**/*"
            }
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 40
        }
      }
    },
    {
      "id": "finish",
      "expect": {
        "has_tools": true,
        "has_tool_result": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "ATK-26 finished."
          }
        ],
        "usage": {
          "input_tokens": 1200,
          "output_tokens": 10
        }
      }
    }
  ],
  "side": [
    {
      "id": "background",
      "expect": {
        "has_tools": false
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Session"
          }
        ]
      }
    }
  ]
}
