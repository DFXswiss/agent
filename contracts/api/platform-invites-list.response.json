{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/platform-invites-list.response.json",
  "title": "GET /v1/platform/invites response",
  "description": "Body of a successful response to GET /v1/platform/invites (03-api.md section 4.2): without `before`/`limit` at most 1 000 rows (`truncated: true` when cut); with them one page of at most 200 rows and next_before (ADR-063 section 2, KOR-35).",
  "type": "object",
  "properties": {
    "invites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "invite_id": {
            "$ref": "../common.json#/$defs/invite_id"
          },
          "kind": {
            "type": "string",
            "const": "user"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "used",
              "revoked",
              "expired"
            ]
          },
          "created_by": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "$ref": "../common.json#/$defs/time"
          },
          "expires_at": {
            "$ref": "../common.json#/$defs/time"
          },
          "registered": {
            "type": "boolean"
          },
          "used_at": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "revoked_at": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "invite_id",
          "kind",
          "state",
          "created_by",
          "created_at",
          "expires_at",
          "registered",
          "used_at",
          "revoked_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "next_before": {
      "$ref": "../common.json#/$defs/next_before"
    },
    "truncated": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "invites"
  ],
  "additionalProperties": false
}
