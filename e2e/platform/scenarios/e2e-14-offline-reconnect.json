{
  "name": "e2e-14-offline-reconnect",
  "description": "E2E-14: one turn of six model steps 3 s apart (five file writes, six outputs), long enough to cut the runner's link to the hub and the browser's live stream in the middle of it.",
  "steps": [
    {
      "id": "one",
      "expect": {
        "user_text_contains": "E2E14-OFFLINE",
        "has_tools": true,
        "has_tool_result": false,
        "stream": true
      },
      "reply": {
        "content": [
          {
            "type": "text",
            "text": "Step one kz14-out-1-a7s2."
          },
          {
            "type": "tool_use",
            "name": "Write",
            "input": {
              "file_path": "${cwd}/one.txt",
              "content": "kz14-file-one\n"
            }
          }
        ]
      }
    },
    {
      "id": "two",
      "expect": {
        "tool_result_is_error": false,
