{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/device-workgroup-usage.response.json",
  "title": "GET /v1/device/workgroups/{wg}/usage response",
  "description": "Body of a successful response to GET /v1/device/workgroups/{wg}/usage (03-api.md section 6.1, ADR-097 section 4).",
  "type": "object",
  "properties": {
    "workgroup_id": {
      "$ref": "../common.json#/$defs/uuid"
    },
    "since": {
      "$ref": "../common.json#/$defs/time"
    },
    "until": {
      "$ref": "../common.json#/$defs/time"
    },
    "by": {
      "type": "string",
      "enum": [
        "task",
        "session"
      ]
    },
    "total": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sessions": {
              "$ref": "../common.json#/$defs/count"
            },
            "tasks": {
              "$ref": "../common.json#/$defs/count"
            },
            "requests": {
              "$ref": "../common.json#/$defs/count"
            },
            "input_tokens": {
              "$ref": "../common.json#/$defs/count"
            },
            "output_tokens": {
              "$ref": "../common.json#/$defs/count"
            },
            "cache_read_tokens": {
              "$ref": "../common.json#/$defs/count"
            },
            "cache_write_tokens": {
              "$ref": "../common.json#/$defs/count"
            },
            "cost_micro_usd": {
              "$ref": "../common.json#/$defs/count"
            },
            "charged_micro_usd": {
              "$ref": "../common.json#/$defs/count"
            },
            "runtime_ms": {
              "$ref": "../common.json#/$defs/count"
            },
            "operations": {
              "$ref": "../common.json#/$defs/count"
            },
            "failed_operations": {
              "$ref": "../common.json#/$defs/count"
            }
          },
          "required": [
            "sessions",
            "tasks",
            "requests",
            "input_tokens",
            "output_tokens",
            "cache_read_tokens",
            "cache_write_tokens",
            "cost_micro_usd",
            "charged_micro_usd",
            "runtime_ms",
            "operations",
            "failed_operations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "a task (by task: with `sessions`) or a session (by session: with the session fields) started in the period",
        "properties": {
          "task_id": {
            "$ref": "../common.json#/$defs/uuid"
          },
          "created_at": {
            "$ref": "../common.json#/$defs/time"
          },
          "sessions": {
            "$ref": "../common.json#/$defs/count"
          },
          "requests": {
            "$ref": "../common.json#/$defs/count"
          },
          "input_tokens": {
            "$ref": "../common.json#/$defs/count"
          },
          "output_tokens": {
            "$ref": "../common.json#/$defs/count"
          },
          "cache_read_tokens": {
            "$ref": "../common.json#/$defs/count"
          },
          "cache_write_tokens": {
            "$ref": "../common.json#/$defs/count"
          },
          "cost_micro_usd": {
            "$ref": "../common.json#/$defs/count"
          },
          "charged_micro_usd": {
            "$ref": "../common.json#/$defs/count"
          },
          "runtime_ms": {
            "$ref": "../common.json#/$defs/count"
          },
          "operations": {
            "$ref": "../common.json#/$defs/count"
          },
          "failed_operations": {
            "$ref": "../common.json#/$defs/count"
          },
          "session_id": {
            "$ref": "../common.json#/$defs/uuid"
          },
          "parent_session_id": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "$ref": "../common.json#/$defs/session_state"
          },
          "model_id": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/model_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "ended_at": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "task_id",
          "created_at",
          "requests",
          "input_tokens",
          "output_tokens",
          "cache_read_tokens",
          "cache_write_tokens",
          "cost_micro_usd",
          "charged_micro_usd",
          "runtime_ms",
          "operations",
          "failed_operations"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "next_before": {
      "$ref": "../common.json#/$defs/next_before"
    }
  },
  "required": [
    "workgroup_id",
    "since",
    "until",
    "by",
    "total",
    "rows",
    "next_before"
  ],
  "additionalProperties": false
}
