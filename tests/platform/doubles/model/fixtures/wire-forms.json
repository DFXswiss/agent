{
  "scenario": {
    "name": "wire-forms",
    "description": "Every answer form of the double: streamed text, tools, thinking, a JSON message, HTTP and stream errors, max_tokens.",
    "steps": [
      {
        "id": "text",
        "expect": {
          "stream": true,
          "user_text_contains": "WIRE-1"
        },
        "reply": {
          "content": [
            {
              "type": "text",
              "text": "Hello from the double, streamed in chunks."
            }
          ],
          "chunk_size": 8,
          "usage": {
            "input_tokens": 1200,
            "cache_creation_input_tokens": 3000,
            "cache_read_input_tokens": 0,
            "output_tokens": 40
          }
        }
      },
      {
        "id": "tools",
        "expect": {
          "stream": true,
          "tools_include": [
            "Write",
            "Read"
          ]
        },
        "reply": {
          "content": [
            {
              "type": "text",
              "text": "Writing in ${cwd}."
            },
            {
              "type": "tool_use",
              "name": "Write",
              "input": {
                "file_path": "${cwd}/notes.txt",
                "content": "alpha\nbeta\n"
              }
            },
            {
              "type": "tool_use",
              "name": "Read",
              "input": {
                "file_path": "${cwd}/notes.txt"
              }
            }
          ],
          "usage": {
            "cache_read_input_tokens": 4200,
            "output_tokens": 20
          }
        }
      },
      {
        "id": "think",
        "expect": {
          "tool_result_contains": "alpha"
        },
        "reply": {
          "content": [
            {
              "type": "thinking",
              "thinking": "The file holds two lines."
            },
            {
              "type": "text",
              "text": "Done: alpha and beta."
            }
          ]
        }
      },
      {
        "id": "plain",
        "expect": {
          "stream": false
        },
        "reply": {
          "content": [
            {
              "type": "text",
              "text": "A JSON answer."
            }
          ],
          "model": "other-model",
          "usage": {
            "input_tokens": 10,
            "output_tokens": 4,
            "service_tier": 1
          }
        }
      },
      {
        "id": "overload",
        "error": {
          "status": 529,
          "type": "overloaded_error",
          "message": "Overloaded (scripted)",
          "headers": {
            "retry-after": "1"
          }
        }
      },
      {
        "id": "stream_err",
        "error": {
          "status": 529,
          "type": "overloaded_error",
          "message": "mid-stream",
          "in_stream": true
        }
      },
      {
        "id": "max",
        "reply": {
          "content": [
            {
              "type": "text",
              "text": "partial"
            }
          ],
          "stop_reason": "max_tokens"
        }
      }
    ]
  },
