{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/credentials/claude_subscription.json",
  "title": "credential body claude_subscription",
  "description": "Plaintext body of the credential kind claude_subscription inside the record ciphertext (04-crypto.md section 4.4). kind setup_token: a long-lived token of `claude setup-token`; kind login_token: the access token of the user's local Claude Code login, transferred by the user's agent tool, with its expiry (11-agent-access.md section 8, ADR-056).",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "printable ASCII without spaces",
      "pattern": "^[!-~]+$",
      "minLength": 1,
      "maxLength": 4096
    },
    "email": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[!-?A-~]{1,64}@[A-Za-z0-9-]{1,63}(\\.[A-Za-z0-9-]{1,63}){0,8}$",
          "maxLength": 254
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "setup_token",
        "login_token"
      ]
    },
    "expires_at": {
      "$ref": "../common.json#/$defs/time",
      "description": "expiry of the token (login_token only)"
    }
  },
  "required": [
    "token",
    "email",
    "kind"
  ],
  "additionalProperties": false
}
