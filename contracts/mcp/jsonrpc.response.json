{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/mcp/jsonrpc.response.json",
  "title": "JSON-RPC response",
  "description": "JSON-RPC 2.0 response of /mcp (03-api.md section 8): result (checked per method) or error.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "$ref": "objects.json#/$defs/rpc_id"
        },
        "result": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "objects.json#/$defs/rpc_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "objects.json#/$defs/rpc_error"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
