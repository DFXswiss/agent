{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/credentials/mailbox.json",
  "title": "credential body mailbox",
  "description": "Plaintext body of the credential kind mailbox inside the record ciphertext (04-crypto.md section 4.4); a user holds several (ADR-099 section 2): name, purpose and the release use {wgs} are optional.",
  "type": "object",
  "properties": {
    "imap_host": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]{1,253}$"
    },
    "imap_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "imap_user": {
      "type": "string",
      "pattern": "^[ -~]+$",
      "minLength": 1,
      "maxLength": 256
    },
    "imap_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "email": {
      "type": "string",
      "pattern": "^[!-?A-~]{1,64}@[A-Za-z0-9-]{1,63}(\\.[A-Za-z0-9-]{1,63}){0,8}$",
      "maxLength": 254
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "use": {
      "type": "object",
      "description": "the workgroups whose sessions may read this mailbox with mail.find (ADR-099 section 3)",
      "properties": {
        "wgs": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.json#/$defs/uuid"
          }
        }
      },
      "required": [
        "wgs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "imap_host",
    "imap_port",
    "imap_user",
    "imap_password",
    "email"
  ],
  "additionalProperties": false
}
