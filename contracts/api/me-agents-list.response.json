{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.dfx.swiss/contracts/api/me-agents-list.response.json",
  "title": "GET /v1/me/agents response",
  "description": "Body of a successful response to GET /v1/me/agents (11-agent-access.md section 4).",
  "type": "object",
  "properties": {
    "agents": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "agent_id": {
            "$ref": "../common.json#/$defs/uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "confirmed",
              "expired",
              "active",
              "revoked"
            ]
          },
          "label_ct": {
            "$ref": "../common.json#/$defs/bundle_ct"
          },
          "created_at": {
            "$ref": "../common.json#/$defs/time"
          },
          "confirmed_at": {
            "$ref": "../common.json#/$defs/time"
          },
          "claimed_at": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_used_at": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "revoked_at": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/time"
              },
              {
                "type": "null"
              }
            ]
          },
          "replaces": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ],
            "description": "the main orchestrator this one replaced at its confirmation (revoked then), or null"
          },
          "remote": {
            "type": "boolean",
            "description": "the agent was paired from another computer (ADR-067); the web client shows a banner while such a main orchestrator is confirmed or active"
          },
          "own_identity": {
            "type": "boolean",
            "description": "the agent signs with its own key as a sub-principal of its user (ADR-082)"
          },
          "held_identity": {
            "type": "boolean",
            "description": "the agent held a sealed copy of the user's identity at some time (paired before ADR-082 or in the old form): the revocation dialog says that this copy keeps opening what is encrypted for the user"
          },
          "gen": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ],
            "description": "the generation of an own-identity agent"
          },
          "revoked_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "revoked",
                  "replaced",
                  "unclaimed",
                  "session_ended"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "why a revoked agent was revoked"
          },
          "pub": {
            "type": "object",
            "properties": {
              "kem": {
                "$ref": "../common.json#/$defs/b64u_32"
              },
              "sig": {
                "$ref": "../common.json#/$defs/b64u_32"
              }
            },
            "required": [
              "kem",
              "sig"
            ],
            "additionalProperties": false,
            "description": "the agent's public keys"
          },
          "cert": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/b64u_64"
              },
              {
                "type": "null"
              }
            ],
            "description": "the user's delegation certificate of an own-identity agent (ADR-082 section 9.1), else null"
          },
          "session_id": {
            "anyOf": [
              {
                "$ref": "../common.json#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ],
            "description": "the orchestrator session the agent runs in (stage b of ADR-082 section 6), null otherwise"
          }
        },
        "required": [
          "agent_id",
          "state",
          "label_ct",
          "created_at",
          "confirmed_at",
          "claimed_at",
          "last_used_at",
          "revoked_at",
          "replaces",
          "remote",
          "own_identity",
          "held_identity",
          "gen",
          "revoked_reason",
          "pub",
          "cert",
          "session_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "agents"
  ],
  "additionalProperties": false
}
